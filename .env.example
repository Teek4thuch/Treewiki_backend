HTTP_ADDR=127.0.0.1:8080
GIN_MODE=debug
# Local development examples. Use separate, private credentials outside development.
DATABASE_URL=postgres://treewiki_runtime:treewiki_runtime_dev@127.0.0.1:5432/treewiki?sslmode=disable
# Used only by the operator CLI; the server does not use this credential.
MIGRATION_DATABASE_URL=postgres://treewiki:treewiki_dev@127.0.0.1:5432/treewiki?sslmode=disable
GBIF_USER_AGENT=TreeWiki/1.0 (plant catalog import)
# Identify the application and a real contact URL or email.
WIKIMEDIA_USER_AGENT=TreeWiki/1.0 (https://example.com/contact; contact@example.com)
